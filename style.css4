* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;

    background: linear-gradient(
        135deg,
        #4facfe,
        #00f2fe
    );

    padding: 30px 15px;
}

.container {
    width: 100%;
    max-width: 900px;
    margin: auto;
}

/* Header */

header {
    text-align: center;
    color: white;
    margin-bottom: 25px;
}

header h1 {
    font-size: 38px;
    margin-bottom: 10px;
}

header p {
    font-size: 17px;
}

/* Search */

.search-box {
    display: flex;
    gap: 10px;
    background: white;
    padding: 15px;
    border-radius: 15px;
    margin-bottom: 25px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

.search-box input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 17px;
    padding: 12px;
}

.search-box button {
    border: none;
    background: #2563eb;
    color: white;
    padding: 12px 25px;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
}

.search-box button:hover {
    background: #1d4ed8;
}

/* Weather Card */

.weather-card {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

.location {
    text-align: center;
    margin-bottom: 25px;
}

.location h2 {
    font-size: 32px;
    color: #172554;
}

.location p {
    color: #64748b;
    margin-top: 5px;
}

/* Main Weather */

.main-weather {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
    margin-bottom: 30px;
}

.temperature {
    font-size: 65px;
    font-weight: bold;
    color: #2563eb;
}

.description {
    font-size: 20px;
    color: #334155;
}

.weather-icon {
    font-size: 55px;
    margin-top: 5px;
}

/* Weather Details */

.weather-details {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.weather-box {
    background: #eff6ff;
    padding: 20px;
    text-align: center;
    border-radius: 15px;
}

.weather-box span {
    font-size: 30px;
}

.weather-box h3 {
    margin: 10px 0;
    font-size: 15px;
    color: #475569;
}

.weather-box p {
    font-size: 18px;
    font-weight: bold;
    color: #1e3a8a;
}

/* Updated */

.updated {
    text-align: center;
    color: #64748b;
    margin-top: 25px;
}

/* Loading */

.loading {
    background: white;
    padding: 20px;
    text-align: center;
    border-radius: 12px;
    color: #2563eb;
    font-weight: bold;
}

/* Error */

.error {
    background: #fee2e2;
    color: #b91c1c;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
}

/* Utility */

.hidden {
    display: none;
}

/* Mobile */

@media (max-width: 700px) {

    body {
        padding: 20px 10px;
    }

    header h1 {
        font-size: 30px;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box button {
        width: 100%;
    }

    .main-weather {
        flex-direction: column;
        gap: 10px;
    }

    .temperature {
        font-size: 55px;
    }

    .weather-details {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 400px) {

    .weather-details {
        grid-template-columns: 1fr;
    }

    .weather-card {
        padding: 20px;
    }
}